{
  "name": "dsh-bench",
  "version": "0.1.0",
  "type": "module",
  "description": "虚拟 DSH 环境跑分机 — 插件/Skill 加载与工具调用基准（L1 零 token）。dsh-plugin-hub 生态的可扩展类插件：为 hub 提供独立性能评分（加载/工具调用各环节耗时）。",
  "keywords": ["dsh-plugin", "dsh-bench", "hub-ext", "benchmark", "deepseek-harness"],
  "bin": {
    "dsh-bench": "./src/index.js"
  },
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yunhuantian/dsh-plugin-hub.git"
  },
  "homepage": "https://github.com/yunhuantian/dsh-plugin-hub",
  "scripts": {
    "bench": "node src/index.js"
  },
  "engines": {
    "node": ">=22.19"
  }
}
